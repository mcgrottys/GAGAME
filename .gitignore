# Build output and one-time-fetch caches (NOAA data re-fetches politely via harvester/).
build/
cache/
__pycache__/

# Generated engine data -- regenerable by the harvesters (see README); keeping the repo lean
# beats shipping 100 MB of decimated public-domain rasters. EXCEPT the survey law: hand
# edits and the surveyed structure vectors they were seeded from are KB-scale text and NOT
# regenerable (the lean rule is for rasters, not the operator's authority).
data/*
!data/gis/
data/gis/*
!data/gis/edits.geojson
!data/gis/structures.kml
!data/gis/osm_structures.json

# Renders, debug dumps, PIX captures, and the rails recording.
*.png
!docs/**/*.png
*.wpix
*.mp4
rail_frames/
swe_events.txt
helm_events.csv
data/swe_cycle.csv

# The user's nested GeoAlgFun clone (redundant once GAGAME itself is published there).
GeoAlgFun/

# Local API keys and the 3 GB Mars pyramids (data/ already covers them, but be explicit).
secrets/

# composed-channel exports (--export artifacts)
*.obj
*.raw
merrimack_*.png
scratch_*

data/aerial/*.rgb
cache/aerial/

tools/Scriptorium/scriptorium.db
tools/Scriptorium/bin/
tools/Scriptorium/obj/

data/overlay/*.rgba
cache/overlay/
out/

# the harvester's C++ tool (harvester/cpp/build.bat)
harvester/cpp/bin/
