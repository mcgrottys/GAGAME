    "wavefield": {
      "_exag": "display exaggeration on the solved comps (vqview shipped 1.15; raise for readable geometry on calm days -- physics in the cache stays raw)",
      "_bankTexelM": "wave bank ring-0 texel (m): caps which wavelengths become GEOMETRY (fold law) -- a band contributes NOTHING until texel < lambda/2. 2.4 left the chop band at exactly zero even with the energy-weighted fold wavelength (3.55 m needs < 1.77 m). 1.2 matches the mesh vertex spacing (~1.19 m) and puts 39%% of the chop into geometry; outer ring reach halves to 9.8 km. Restart to apply (ring construction).",
      "enabled": true,
      "orgX": -1400,
      "orgZ": -800,
      "nx": 1600,
      "ny": 1000,
      "cellM": 2,
      "comps": 32,
      "spreadDeg": 26,
      "barNormalDeg": 285,
      "gammaHs": 0.6,
      "minSamplesPerLambda": 8,
      "tideBucketM": 0.25,
      "currentBucketMs": 0.1,
      "featherM": 120,
      "chop": 1.1,
      "exag": 1.6,
      "bankTexelM": 1.2
    },
    "closures": {
      "_bandFoldWeight": "how far the FOLD's per-band wavelength follows the live spectrum instead of the band's geometric midpoint (cascade 2 spans lambda 0.41-12 m; a 4.6 m wind sea judged as 2.2 m is thrown out of geometry). 0 = the shipped constant, byte for byte.",
      "_windSeaFill": "gain on the Pierson-Moskowitz wind sea synthesised from the GFS wind on hours whose partitions are all swell (a 4 mHz Gaussian with no tail -- cascades 1-2 realize exactly zero and the water renders as glass). 0 = off, byte for byte.",
