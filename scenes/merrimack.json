{
  "_readme": [
    "The default shipped scene (M12 step 5a): the Merrimack estuary in the one world frame, from",
    "the north jetty tip -- what `gagame --sea` has always meant. Every value is the legacy flag's",
    "default, so a scene that says nothing means what the flags meant; scenes/recipes/*.json are",
    "this file with a few keys overridden, each carrying the flag line that made it in _recipe.",
    "Sections, keys and units: src/scene/SceneSchema.h. Overlays (stronger than this file):",
    "scenes/views/builtin.json (the kept views) and data/wave_scene.json (the M8 water scene, at",
    "`water`; authored if absent, never clobbered). Resolution: defaults < this file < includes",
    "< --set, objects by key, named arrays by name, placements replaced whole (SceneBuilder.h)."
  ],
  "scene": {"name": "merrimack", "mode": "world", "planet": "earth", "view": "sea"},
  "include": [
    {"file": "scenes/views/builtin.json", "at": "", "optional": false},
    {"file": "data/wave_scene.json", "at": "water", "optional": true}
  ],
  "data": {
    "shaders": "shaders",
    "tides": "data/tides/stations.json",
    "seastate": "data/sea/seastate.json",
    "currents": "data/currents/currents.json",
    "bathy": "data/bathy/merrimack.json"
  },
  "time": {"start": "now", "timeScale": 1, "paused": false, "windowDays": 7},
  "sun": {"source": "ephemeris", "az": 112, "el": 26},
  "sea": {
    "storm": {"hs": 0, "tp": 10, "dir": 90},
    "datum": {"fromStation": true, "mllwToNavd": -1.3},
    "box": [-71.2, 41.5, -68.5, 44.5]
  },
  "water": {
    "pixelWater": true,
    "foam": 1,
    "edgePx": 12,
    "heightScale": 1.15,
    "swe": {"enabled": true, "westBoundary": true, "spinupH": 1, "gain": 1, "riverQ": -1},
    "bank": {"flatBed": false, "flatBedNavd": -30},
    "wavefield": {
      "enabled": true,
      "orgX": -1400,
      "orgZ": -800,
      "nx": 1600,
      "ny": 1000,
      "cellM": 2,
      "comps": 32,
      "spreadDeg": 26,
      "barNormalDeg": 285,
      "gammaHs": 0.6,
      "minSamplesPerLambda": 8,
      "tideBucketM": 0.25,
      "currentBucketMs": 0.1,
      "featherM": 120,
      "chop": 1.1,
      "exag": 1.15,
      "bankTexelM": 1.2
    },
    "closures": {
      "shedSteepCap": 0.44,
      "shedMssCeil": 0.09,
      "churnGain": 0.12,
      "crestLo": 0.28,
      "crestHi": 0.8,
      "depthLo": 1.05,
      "depthHi": 1.95,
      "foamOpacity": 0.72,
      "ringBlendTexels": 48,
      "bandFoldWeight": 1,
      "windSeaFill": 1,
      "buoyAssimAgeH": 6,
      "buoyAssimGainMax": 1.8,
      "causticStrength": 0.6,
      "waterOptics": true,
      "jettyCrestNavd": -99
    },
    "fleet": {"enabled": false, "boats": []}
  },
  "streaming": {
    "tileBudget": 1000,
    "predictEvery": 3,
    "directStorage": true,
    "colorTrees": true,
    "gisGate": true,
    "seafloor": true,
    "exposure": true
  },
  "capture": {
    "headless": false,
    "width": 1600,
    "height": 900,
    "frames": 0,
    "dump": "",
    "hdr": "",
    "mp4": "",
    "railDir": "",
    "settle": {"sync": false, "hold": 0, "exact": false, "clearChurn": false}
  },
  "views": [
    {
      "name": "chart",
      "_at": "the M1 chart's oblique, computed from the river's length (FrameLoop::Session); no placement here",
      "fovY": 55,
      "gauge": "root",
      "nearZ": 0.25
    },
    {
      "name": "sea",
      "_at": "the vqview signature shot: the north jetty tip, az 246 back into the inlet",
      "at": {"x": 522, "alt": 7, "z": 72, "az": 246, "pitch": -4},
      "fovY": 55,
      "gauge": "root",
      "nearZ": 0.25
    },
    {
      "name": "orbit",
      "_at": "the globe start: over the North Atlantic at 2.1 planet radii, aimed at the centre",
      "at": {"lat": 34, "lon": -52, "alt": 13379100},
      "fovY": 55,
      "gauge": "root",
      "nearZ": 0.25
    }
  ],
  "rails": {"active": "none", "keys": [], "droste": {"levelSec": 16, "levels": 3}},
  "portals": [],
  "entities": [],
  "effects": [],
  "layers": [
    {"name": "sky", "enabled": true},
    {"name": "tide", "enabled": true, "exaggeration": 60},
    {"name": "sea", "enabled": true},
    {"name": "terrain", "enabled": true},
    {"name": "gulf", "enabled": true},
    {"name": "waterbank", "enabled": true},
    {"name": "globe", "enabled": true},
    {"name": "gis", "enabled": true},
    {"name": "vessels", "enabled": true},
    {"name": "markers", "enabled": true}
  ],
  "nodes": [],
  "tools": [],
  "sources": [
    {"name": "massgis.coq2023", "manifest": "data/aerial/aerial.json", "feather": 25},
    {"name": "user.highlights", "manifest": "data/overlay/overlay.json", "feather": 25, "over": 1}
  ]
}
